# Robinhood Chain
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
SETTLEMENT_ADDRESS=0x...            # from contracts/deployments/robinhood.json
RELAYER_PRIVATE_KEY=0x...           # hot wallet, keep only a little ETH on it

# Swaps
SWAP_ADAPTER=uniswap
UNISWAP_API_KEY=...                 # Uniswap developer portal
SLIPPAGE_BPS=300                    # payer signs for quote + 3%
MAX_PRICE_IMPACT=0.05               # refuse tokens too thin to swap
TOKEN_DENYLIST=                     # comma-separated token addresses

# Gas fee charged to payers (covers the relayer's settlement gas)
SETTLE_GAS_SWAP=600000
SETTLE_GAS_USDG=200000
GAS_MARGIN_BPS=2000                 # +20% over the estimate
GAS_TOLERANCE_BPS=3000              # accept signed gas fees down to 70% of today's price
WETH_ADDRESS=0x...                  # Robinhood Chain WETH, used to read the ETH price from Uniswap
# ETH_USD_PRICE=3000                # or pin a price instead
EXACT_ENABLED=false                 # plain EIP-3009 USDG; relayer pays its gas uncharged

# Gas sponsorship for first-time Permit2 approvals
SPONSOR_ENABLED=true
SPONSOR_MAX_WEI=100000000000000     # 0.0001 ETH cap per wallet
SPONSOR_DAILY_MAX=200

PORT=4021
DATA_DIR=./data
