{
  "name": "@paywithtender/mcp",
  "version": "0.1.4",
  "mcpName": "io.github.paywithtender/tender",
  "description": "MCP server that lets any AI agent pay x402 APIs with any token on Robinhood Chain, through Tender.",
  "license": "MIT",
  "homepage": "https://paywithtender.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paywithtender/tender.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "robinhood-chain",
    "payments",
    "usdg",
    "ai-agents",
    "tender"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "tender-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paywithtender/sdk": "^0.1.3",
    "viem": "^2.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
